<?xml version="1.0" encoding="UTF-8"?>
<Installer>
    <Name>CodexBarX</Name>
    <Version>0.1.0</Version>
    <Title>CodexBarX Setup</Title>
    <Publisher>CodexBarX</Publisher>
    <ProductUrl>https://github.com/basil520/CodexBarX</ProductUrl>
    <InstallerWindowIcon>icon</InstallerWindowIcon>
    <InstallerApplicationIcon>icon</InstallerApplicationIcon>
    <StartMenuDir>CodexBarX</StartMenuDir>
    <TargetDir>@ApplicationsDirX86@/CodexBarX</TargetDir>
    <RunProgram>@TargetDir@/CodexBarX.exe</RunProgram>
    <RunProgramDescription>Launch CodexBarX after installation</RunProgramDescription>
    <MaintenanceToolName>Uninstall</MaintenanceToolName>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <WizardStyle>Classic</WizardStyle>
    <StyleSheet>stylesheet.qss</StyleSheet>
    <TitleColor>#ffffff</TitleColor>
</Installer>
