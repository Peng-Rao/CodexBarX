/* CodexBarX Product Console theme for Qt Installer Framework. */
* {
    color: #ffffff;
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QWizard {
    background-color: #10101f;
    border: 1px solid #303050;
    min-height: 520px;
    min-width: 780px;
}

QWizardPage,
QDialog,
QStackedWidget {
    background-color: #1a1a2e;
    color: #ffffff;
}

QWidget {
    background-color: #1a1a2e;
    color: #ffffff;
}

QFrame {
    background-color: transparent;
    border: none;
}

QLabel {
    background-color: transparent;
    color: #d7d7e6;
}

QLabel:disabled {
    color: #555555;
}

QLabel#TitleLabel,
QLabel[heading="true"] {
    color: #ffffff;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#SubTitleLabel {
    color: #b8b8c8;
    font-size: 10pt;
}

QLabel#MessageLabel {
    background-color: #1f1f38;
    border: 1px solid #34345a;
    border-radius: 8px;
    color: #d7d7e6;
    min-height: 132px;
    min-width: 420px;
    padding: 18px;
}

QLabel#InformationLabel,
QLabel#LicenseInfoLabel {
    color: #b8b8c8;
}

QLabel#ErrorLabel {
    color: #ff8a8a;
}

QGroupBox {
    background-color: #1f1f38;
    border: 1px solid #34345a;
    border-radius: 8px;
    color: #ffffff;
    font-weight: 600;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
}

QGroupBox::title {
    background-color: #1f1f38;
    color: #ffffff;
    left: 12px;
    padding: 0 6px;
    subcontrol-origin: margin;
}

QAbstractScrollArea,
QTextEdit,
QPlainTextEdit,
QTextBrowser,
QTreeView,
QTableView,
QListView,
QListWidget {
    background-color: #1f1f38;
    alternate-background-color: #252540;
    border: 1px solid #34345a;
    border-radius: 8px;
    color: #ffffff;
    outline: none;
    selection-background-color: #3a3a5c;
    selection-color: #ffffff;
}

QTextBrowser,
QTextEdit,
QPlainTextEdit {
    padding: 10px;
}

QListView,
QListWidget,
QTreeView,
QTableView {
    show-decoration-selected: 1;
}

QListView::item,
QListWidget::item,
QTreeView::item {
    background-color: transparent;
    border-radius: 6px;
    color: #d7d7e6;
    min-height: 28px;
    padding: 6px 10px;
}

QListView::item:selected,
QListWidget::item:selected,
QTreeView::item:selected {
    background-color: #3a3a5c;
    color: #ffffff;
}

QListView::item:hover:!selected,
QListWidget::item:hover:!selected,
QTreeView::item:hover:!selected {
    background-color: #2a2a4a;
    color: #ffffff;
}

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #15152a;
    border: 1px solid #44446e;
    border-radius: 7px;
    color: #ffffff;
    min-height: 28px;
    padding: 5px 9px;
    selection-background-color: #3a3a5c;
    selection-color: #ffffff;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover {
    border-color: #5b5ba0;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTextBrowser:focus,
QTreeView:focus,
QTableView:focus,
QListView:focus,
QListWidget:focus {
    border-color: #6b6bff;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background-color: #1f1f38;
    border-color: #2a2a4a;
    color: #555555;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: none;
}

QComboBox QAbstractItemView {
    background-color: #1f1f38;
    border: 1px solid #44446e;
    color: #ffffff;
    selection-background-color: #3a3a5c;
}

QCheckBox,
QRadioButton {
    background-color: transparent;
    color: #d7d7e6;
    spacing: 8px;
}

QCheckBox:hover,
QRadioButton:hover {
    color: #ffffff;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #555555;
}

QCheckBox::indicator,
QRadioButton::indicator {
    background-color: #15152a;
    border: 1px solid #55558a;
    height: 16px;
    width: 16px;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #6b6bff;
}

QCheckBox::indicator:checked {
    background-color: #6b6bff;
    border-color: #8a8aff;
}

QRadioButton::indicator:checked {
    background-color: #6b6bff;
    border: 4px solid #15152a;
}

QPushButton {
    background-color: #24243c;
    border: 1px solid #45456e;
    border-radius: 7px;
    color: #d7d7e6;
    font-weight: 600;
    min-height: 30px;
    min-width: 82px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #2a2a4a;
    border-color: #6b6bff;
    color: #ffffff;
}

QPushButton:focus {
    border-color: #8a8aff;
}

QPushButton:pressed {
    background-color: #3a3a5c;
    border-color: #8a8aff;
}

QPushButton:default {
    background-color: #6b6bff;
    border-color: #8a8aff;
    color: #ffffff;
}

QPushButton:default:hover {
    background-color: #8a8aff;
    border-color: #a5a5ff;
}

QPushButton:default:pressed {
    background-color: #4a4a7c;
    border-color: #6b6bff;
}

QPushButton:disabled {
    background-color: #18182c;
    border-color: #2a2a4a;
    color: #555555;
}

QProgressBar {
    background-color: #15152a;
    border: 1px solid #44446e;
    border-radius: 6px;
    color: #ffffff;
    min-height: 20px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #6b6bff;
    border-radius: 5px;
}

QHeaderView::section {
    background-color: #252540;
    border: 1px solid #34345a;
    color: #ffffff;
    font-weight: 600;
    padding: 6px;
}

QScrollBar:vertical {
    background-color: #15152a;
    border: none;
    margin: 0;
    width: 12px;
}

QScrollBar::handle:vertical {
    background-color: #4a4a7c;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6b6bff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #15152a;
    border: none;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #4a4a7c;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6b6bff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QToolTip {
    background-color: #252540;
    border: 1px solid #6b6bff;
    color: #ffffff;
    padding: 5px;
}
